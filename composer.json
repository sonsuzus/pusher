{
    "name": "sonsuzus/pusher",
    "description": "Soketi destekli özel Pusher eklentisi.",
    "type": "flarum-extension",
    "keywords": [
        "discussion",
        "websocket",
        "soketi",
        "pusher"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "sonsuz",
            "email": "sonsuzus@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/sonsuzus/pusher/issues",
        "source": "https://github.com/sonsuzus/pusher",
        "forum": "https://sonsuz.us"
    },
    "homepage": "https://sonsuz.us",
    "replace": {
        "flarum/pusher": "*"
    },
    "require": {
        "flarum/core": "^1.8",
        "pusher/pusher-php-server": "^7.0"
    },
    "require-dev": {
        "flarum/tags": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Flarum\\Pusher\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "flarum-extension": {
            "title": "Sonsuzus Pusher (Soketi)",
            "category": "feature",
            "icon": {
                "name": "fas fa-broadcast-tower",
                "backgroundColor": "#1e293b",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
