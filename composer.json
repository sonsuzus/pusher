{
    "name": "sonsuzus/pusher",
    "description": "Flarum için Soketi (Sonsuzus) destekli gerçek zamanlı bildirim eklentisi.",
    "type": "flarum-extension",
    "keywords": ["discussion", "soketi", "pusher", "websocket"],
    "license": "MIT",
    "authors": [
        {
            "name": "SonsuzUs",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "flarum/tags": "*"
    },
    "autoload": {
        "psr-4": {
            "Flarum\\Pusher\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Soketi (Sonsuzus)",
            "category": "feature",
            "icon": {
                "name": "fas fa-bolt",
                "backgroundColor": "#311b58",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}