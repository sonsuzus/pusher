{
    "name": "sonsuzus/pusher",
    "description": "Flarum için Soketi (Sonsuzus) destekli gerçek zamanlı bildirim eklentisi.",
    "type": "flarum-extension",
    "keywords": [
        "discussion",
        "soketi",
        "pusher",
        "websocket"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "SonsuzUs",
            "role": "Developer"
        }
    ],
    "require": {
        "flarum/core": "^1.8",
        "pusher/pusher-php-server": "^2.2"
    },
    "require-dev": {
        "flarum/tags": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Flarum\\Pusher\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Soketi (Sonsuzus)",
            "category": "feature",
            "icon": {
                "name": "fas fa-bolt",
                "backgroundColor": "#311b58",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
